{
	"manifest_version": 3,
	"name": "yeetbin (local)",
	"short_name": "yeetbin",
	"version": "0.1.0",
	"description": "Read markdown, code and diagrams with yeetbin's renderer without uploading them. Publish to yeetbin only when you choose.",
	"key": "",
	"minimum_chrome_version": "116",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Local yeetbin",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["nativeMessaging", "unlimitedStorage", "alarms"],
	"host_permissions": ["https://yeet.kautiontape.com/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	}
}
